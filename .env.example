# Copy to .env and fill in the keys you need:
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This template is safe to commit.
#
# Generation uses Groq only. Embeddings (MiniLM) stay local.
# Get a key from https://console.groq.com/keys and paste it below.

# ---------------------------------------------------------------- groq (required for chat)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------- optional tooling
# Raises Hugging Face Hub rate limits and speeds up the first model download.
# The pipeline logs an "unauthenticated requests" warning without it.
HF_TOKEN=

# Optional: relocate the data/ directory (raw, processed, chroma).
RAG_DATA_DIR=
